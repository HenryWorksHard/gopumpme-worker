# Solana RPC (Helius recommended)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Supabase (service role — server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Same AES key the web app uses to encrypt per-fund escrow keys
WALLET_ENCRYPTION_KEY=64_hex_chars

# Operations wallet: pays claim tx fees and runs the $Donate buyback+burn.
# base58 secret key. (Provided by the operator.)
OPS_WALLET_SECRET=

# $Donate platform token mint (the coin to buy back and burn)
GPM_MINT=

# Split + thresholds
CHARITY_BPS=8000            # 80% to the charity escrow
BUYBACK_BPS=2000           # 20% buys back + burns $Donate
MIN_CLAIM_SOL=0.02         # only claim when a vault holds at least this
SOL_FEE_BUFFER=0.01        # SOL kept in each escrow for future tx fees
POLL_SECONDS=300           # run every 5 minutes
